# "mock" werkt zonder CBR-toegang. "cbr" is pas bruikbaar na goedkeuring als Leverancier.
DATABASE_PATH=./data/app.db

# Basis-URL voor links in e-mails (zonder slash). Verplicht correct instellen in productie.
APP_URL=http://localhost:3000
# SMTP voor verificatie-, reset- en goedkeuringsmails. Gebruik een provider binnen de EER.
# Leeg = ontwikkelmodus (mail naar tabel "outbox" + serverlog); in productie is dat een fout.
SMTP_URL=
MAIL_FROM="CBR Inplanner <noreply@voorbeeld.nl>"
# Optioneel: krijgt een melding zodra een nieuwe rijschool haar e-mailadres heeft bevestigd.
ADMIN_NOTIFY_EMAIL=
CBR_MODE=mock
# Alleen mock: "off" simuleert een API zonder overzicht van machtigingen (terugval met handmatige invoer).
CBR_MOCK_AUTH_LIST=on
# Hoe vaak het overzicht van gemachtigde leerlingen bij het CBR wordt opgehaald (eerlijk gebruik).
AUTH_SYNC_TTL_MS=300000
AUTH_SYNC_MIN_INTERVAL_MS=15000

# Alleen voor CBR_MODE=cbr (waarden komen uit de CBR Developer Portal na acceptatie)
CBR_API_BASE_URL=
CBR_API_KEY=
# Uitgaand verkeer naar het CBR moet via een vast, vooraf gedeeld IP-adres lopen
# (geen generieke cloud-ranges, geen VPN). Zie docs/architectuur.md.
CBR_EGRESS_PROXY_URL=
